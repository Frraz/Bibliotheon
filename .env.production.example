# Copie para arquivo privado (chmod 600); não versione valores reais.
BIBLIOTHEON_IMAGE=registry.example.invalid/bibliotheon@sha256:REPLACE_WITH_REAL_DIGEST
BIBLIOTHEON_PORT=REPLACE_AFTER_VPS_INVENTORY
PUBLIC_SITE_URL=https://bibliotheon.com.br
PAYLOAD_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DB_OWNER_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_OWNER_PASSWORD
DB_RUNTIME_PASSWORD=REPLACE_WITH_UNIQUE_RUNTIME_PASSWORD
# Percent-encode caracteres especiais das senhas nas URLs.
DATABASE_URL=postgresql://bibliotheon_runtime:REPLACE@db:5432/bibliotheon
DATABASE_MIGRATION_URL=postgresql://bibliotheon_owner:REPLACE@db:5432/bibliotheon
CHECKOUT_ALLOWED_HOSTS_HOTMART=
CHECKOUT_ALLOWED_HOSTS_KIWIFY=
CHECKOUT_ALLOWED_HOSTS_CAKTO=

# Keep disabled until account/sender/privacy/suppression are homologated.
LEAD_TOKEN_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_KEY_OF_AT_LEAST_32_BYTES
LEADS_ENABLED=false
EMAIL_TRANSPORT_ENABLED=false
# Consulta/bloqueio de contatos; não envia mensagens. Ativar apenas após homologação.
BREVO_CONTACT_SYNC_ENABLED=false
# Cadastro de contatos confirmados; exige bloqueios habilitados. Não envia campanhas.
BREVO_CONTACT_REGISTRATION_ENABLED=false
# Listas exclusivas de lotes; habilitar só após homologar pasta e automações.
BREVO_LIST_SYNC_ENABLED=false
BREVO_LIST_FOLDER_ID=
# Link individual em atributo normal/text homologado; não cria campanha nem envia.
BREVO_PREFERENCE_SYNC_ENABLED=false
# Rascunhos apenas; exige listas/preferências/bloqueios e remetente homologado.
BREVO_CAMPAIGN_SYNC_ENABLED=false
BREVO_CAMPAIGN_SENDER_ID=
# Disparo real: manter false até homologação de conta, quota, remetente e templates.
BREVO_CAMPAIGN_SEND_ENABLED=false
BREVO_DAILY_QUOTA=250
BREVO_TRANSACTIONAL_RESERVE=50
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Bibliotheon
LEAD_REQUESTS_PER_ADDRESS_DAY=5
TZ=America/Belem
