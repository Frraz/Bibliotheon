# Copie para .env no servidor e preencha. Nunca versione o .env.

# Endereço público (fixado no build: canonical, sitemap, OG, JSON-LD)
SITE_URL=https://bibliotheon.com.br

# Porta no loopback do servidor (confira se está livre com: ss -tlnp)
PORTA=

# Medição (opcional; fixados no build). Sem eles nada de terceiros é carregado e o banner de cookies nem aparece.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# Contato exibido nos Termos, na Privacidade e no rodapé (LGPD). Preencha antes de divulgar.
NEXT_PUBLIC_CONTATO_EMAIL=

# Token de deploy/venda.sh (preço, campanha, textos, relatório, leads). Gere com: openssl rand -hex 32. Sem ele, a API fica fechada.
API_TOKEN=

# Avisos de venda das lojas (opcional; mede vendas por origem). Cada loja tem o seu segredo; sem ele, a loja não entra.
# Hotmart: o "hottok" da conta (Ferramentas > Webhook). Kiwify: o token do webhook. Cakto: o secret do webhook. Passo a passo: docs/06-deploy.md.
HOTMART_HOTTOK=
KIWIFY_WEBHOOK_TOKEN=
CAKTO_WEBHOOK_SECRET=

# Segredo do login do painel (assina cookies e tokens). Gere com: openssl rand -base64 32. Sem ele, /entrar não funciona; o site público segue no ar.
BETTER_AUTH_SECRET=

# E-mail para recuperar senha (opcional). Sem SMTP_HOST, "Esqueci a senha" manda falar com o administrador.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORTA=465, SMTP_USUARIO=seu@gmail.com e SMTP_SENHA = "senha de app" (16 letras, em myaccount.google.com/apppasswords; exige verificação em duas etapas).
SMTP_HOST=
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=
# Quem aparece como remetente. Vazio = "Bibliotheon <SMTP_USUARIO>". Use aspas: o atualizar.sh lê o .env como shell, e valor com espaço ou <> sem aspas dá erro de sintaxe.
EMAIL_REMETENTE=

# Tag da imagem Docker (para rollback): o atualizar.sh preenche com o commit
IMAGE_TAG=latest
