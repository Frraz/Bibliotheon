# Owner is created via admin:create, never through public registration.
# Production credentials must never be committed.
# Sample capture stays off until sender, privacy and provider quota are verified.
LEAD_TOKEN_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_KEY_OF_AT_LEAST_32_BYTES
LEADS_ENABLED=false
EMAIL_TRANSPORT_ENABLED=false
BREVO_DAILY_QUOTA=250
BREVO_TRANSACTIONAL_RESERVE=50
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
