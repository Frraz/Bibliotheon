# Copie para .env no servidor e preencha. Nunca versione o .env.

# Endereço público (fixado no build: canonical, sitemap, OG, JSON-LD)
SITE_URL=https://bibliotheon.com.br

# Porta no loopback do servidor (reaproveite a do v1; confira com: ss -tlnp)
PORTA=

# Medição (opcional; fixados no build). Sem eles nada de terceiros é carregado e o banner de cookies nem aparece.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# Contato exibido nos Termos, na Privacidade e no rodapé (LGPD). Preencha antes de divulgar.
NEXT_PUBLIC_CONTATO_EMAIL=

# Token de deploy/venda.sh (preço, campanha, textos, relatório, leads). Gere com: openssl rand -hex 32. Sem ele, a API fica fechada.
API_TOKEN=

# Segredo do login do painel (assina cookies e tokens). Gere com: openssl rand -base64 32. Sem ele, /entrar não funciona; o site público segue no ar.
BETTER_AUTH_SECRET=

# Tag da imagem Docker (para rollback): o atualizar.sh preenche com o commit
IMAGE_TAG=latest
